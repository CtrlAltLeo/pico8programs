pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
px, py = 0,63

spd = 1


function do_spd(x)
	
	f =  x ^ 2
	
	fprime = x * 2
	
	return fprime
		
end

function _update()
	

		spd = do_spd(time())
		
	
px += spd		
	
if px > 128 then
	px = 0
end	

end


function _draw()
	
	cls()
	pset(px,py,8)
	print(do_spd(time()))
	print(time())
end
