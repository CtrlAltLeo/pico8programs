pico-8 cartridge // http://www.pico-8.com
version 39
__lua__

function _update()

end

brot = 0

function _draw()

	cls()
	
		t = time() * .15

		for i = 0, 100,t do

			brot += 0.1
			line(
								(i-1)*cos(brot-0.1)+63, 
								(i-1)*sin(brot-0.1)+63,
								i*cos(brot)+63, 
								i*sin(brot)+63,
								8)
		end
		
		brot = time() * 0.25
		

	
end
