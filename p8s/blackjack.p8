pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
--pico 8 blackjack

deck = {}
house = {}
hand = {}

function add_card(suit, rank, dest)
	
	card = {s=suit,r=rank,show=false,
									x=0,y=0}
	
	add(dest, card)	
	
end

function fill_deck()
	
	for suit = 1,4 do
		for rank = 1,13 do
			
			add_card(suit, rank, deck)
			
		end
	end
	
	for i = 0, 500 do
		
		c1 = flr(rnd(52))+1
		c2 = flr(rnd(52))+1
		
		swap = deck[c1]
		deck[c1] = deck[c2]
		deck[c2] = swap
		
	end
	
end

function draw_card(x,y,c)
	
	w = 20
	h = 30
	
	if c.show then
	
		rectfill(x,y,x+w,y+h,7)
		rectfill(x,y,x+2,y+h,15)
		
		if c.s % 2 == 0 then
			col = 8
		else	
			col = 1
		end
		
		spr(c.s, x+w/2-2, y+h/2-2)	
		
		print(spr_rank(c.r),x+1,y+1,col)
		
		print(spr_rank(c.r),x+w-3,y+h-5,col)
	else
		
		rectfill(x,y,x+w,y+h,8)
		
		for i = 0,w,4 do
			line(x+i, y, x+i*.5, y+h,1)
		end
	
	end
	
	
end


function spr_rank(r)
	
	if r > 1 and r < 11 then
		return r
	end
	
	if r == 1 then
		return "a"
	end
	
	r = r - 10
	
	faces = {"j","q","k"}
	
	return faces[r]
	
end




function _init()
	
	start_game()
	flip_player_cards()
	message("shmungus?")
end

function _update()
	
	if btnp(❎) then
		
		hit()
		
		
	end
	
	
end

py = 128
function _draw()

 cls()

	//felt
	rectfill(0,0,128,128,3)

	draw_hand(80,hand)
	
	draw_hand(20,house)
	
	draw_message()
	
	draw_p_stats()

end
-->8
--player hand

function flip_player_cards()
	
	for c in all(hand) do
		c.show = true
	end	
	
end


function hit()
	
	deal_card(hand)
	flip_player_cards()
	
end

function draw_p_stats()
	
	rectfill(2,110,24,124,8)
	
	print(calc_hand(hand),11,111,7)
	spr(1,3,111)
	
	print(p_money, 11, 118,7)
	spr(13,4,117)
end
-->8
--card functions

function deal_card(h)
	
	if #deck > 0 then
		add(h, deck[1])
		del(deck, deck[1])
	end
	
end

function draw_hand(y,h)
	
	dist = 0
	
	x = 64/#h
	
	for c in all(h) do
		
		c.y -= flr((c.y - y)*.15)
		
		c.x -= (c.x - x)*.15
		
		draw_card(c.x+dist, c.y, c)
		dist += 100 / #h
		
	end
	
end

function start_game()
	
	fill_deck()
	
	for i = 0,1 do
		deal_card(hand)
		deal_card(house)
	end
	
end

function calc_hand(h)
	
	tot = 0
	
	for c in all(h) do
		
		if c.r > 1 and c.r < 11 then
			tot += c.r
		elseif c.r > 10 then
			tot += 10
		else //ace
			
			if tot + 11 < 21 then
				tot += 11
			else
				tot += 1
			end
			
		end
		
	end
	
	return tot
	
end



-->8
--particles

-->8
--betting

p_money = 100

-->8
--messaging system


mess= ""

mx,my = 0,0

x_targ = 0

m_time = 0

function message(m)
	mess = m
	mx,my = 0,0
	
	m_time = time() + 3
	x_targ = 64-((#mess*4)/2)
	
end

function draw_message()

 mx -= (mx - x_targ)*.15


 my = 64

	print(mess,mx,my,7)
	
	if time() > m_time then
 	x_targ = 200
	end
	
	if mx > 500 then
		x_targ = 0
	end
	
end
