-->8
--print_r()

function print_r(x,y,r,t0,string)
--	circ(x,y,r,10)
--circfill(x,y,r-8,9)

	words = split(string, " ", false)
		
	for w in all(words) do
		
		dt = 0.05
		
		tf = t0 + #w*dt
		
		st_count = 1
		
	
		
		line(x,y,r*cos(t0)+x,r*sin(t0)+y,11)
		line(x,y,r*cos(tf)+x,r*sin(tf)+y,8)
		
		for rot = t0,-tf,-dt do
			
			x1 = x + cos(rot) * r
			y1 = y + sin(rot) * r
			
			print(
				sub(w,st_count, st_count),
				x1,
				y1,
				9
			)
			
			st_count += 1
			
		end
		
	 t0 = t0 - tf
		
	end
		 
end

-->8
--lib 

function flip_str(string)

	s_new = ""
	
	for i = #string, 1, -1 do
		
		s_new = s_new .. sub(string,i,i)
		
	end
	
	return s_new
	
end
