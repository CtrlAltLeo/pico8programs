pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
x,y = 63,63

rot = 0


function _update()
	
	if btn(⬅️) then rot += 5 end
	if btn(➡️) then rot -= 5 end
	if btn(⬆️) then 
	
		x += cos(rot / 360)
		y += sin(rot / 360)
	
	end
	
	sfx(0)
	
	
	
end


function _draw()
	
	cls()
	rectfill(0,0,128,128,12)
	--nose
	pset(x,y,4)
	
	lx = cos(rot/360)
	ly = sin(rot/360)
	
	lx1 = cos((rot + rnd(360))/360)
	ly2 = 	sin((rot + rnd(360))/360)
	line(x,y,lx*10+x,ly*10+y,7)
	
	line(x,y,lx1*10+x,ly2*10+y,8)
	
	
end
