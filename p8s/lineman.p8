pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
p = {x=63,y=63}

l = {}

rot = 0

function add_p(x,y)

	t = {x,y}
	
	add(l, t)

end

function _init()
	
	add_p(0,0)
	add_p(p.x,p.y)
end

function _update()
	
	
		p.x += cos(rot / 360)
		p.y += sin(rot / 360)

	l[2][1] = p.x
	l[2][2] = p.y
	
	if btn(⬅️) then rot += 10 end
	if btn(➡️) then rot -= 10 end
	
		
	if time() % 1 == 0 then
		add_p(p.x,p.y)
	end
	
end

function _draw()
	cls()
	
	draw_lines()
	
	pset(p.x,p.y,11)
	pset(cos(rot/360)*2+p.x,sin(rot/360)*2+p.y,7)

	check_hit()
	


end

function draw_lines()
	
	for i = 1,#l do
	
		if i == #l then
			line(l[i][1],l[i][2],p.x,p.y,8)
		else
			
			x1,y1 = l[i][1],l[i][2]
			x2,y2 = l[i+1][1],l[i+1][2]
			
			line(x1,y1,x2,y2,9)
		end
		
	end	
end

function check_hit()
		
		if #l < 3 then
			return
		end
		
		zar = 3
		
		x1,y1 = l[zar][1],l[zar][2]
		x2,y2 = l[1][1],l[1][2]
		
		slope = (y2-y1)/(x2-x1)
		
		for z = x1,x2,.01 do
			pset(z,z*slope,12)

		end
		

	
end
