pico-8 cartridge // http://www.pico-8.com
version 39
__lua__

xi,yi = 0,127
x,y = xi,yi

vx,vy = 1,-2
ax,ay = 0,5

t = 0

path = {}

function _update()
	
	x = x + vx*t + .5*ax*t^2
	y = y + vy*t + .5*ay*t^2
	
	add(path, {x,y})
	
	t += .03
	
	if btn(⬅️) then
		vx -= 1
	elseif btn(➡️) then
		vx += 1
	end
	
	if btn(⬆️) then
		vy -= 1
	elseif btn(⬇️) then
		vy += 1
	end
	
	if btn(❎) then
		x,y = xi,yi
		t = 0
	end
	
	
end


function _draw()
	cls()
	spr(1,x,y)
	
	for p in all(path)do
	
		pset(p[1],p[2],7)
	
	end
	
	
end
