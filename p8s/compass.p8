pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
x,y = 63,120
tx,ty = 25,25

angle = 0

function _update()
	
	if btn(⬅️) then
		x -= 1
	elseif btn(➡️) then
		x += 1
	end
	
	
	if btn(⬇️) then
		y += 1
	elseif btn(⬆️) then
		y -= 1
	end
	
end


function _draw()
	
	cls() 
	
	
	angle = atan2(tx-x,ty-y)
	
--	print(angle)
	
	
--	line(x,y,tx,ty,2)
	
	spr(2,x,y)
	spr(1,tx,ty)
	
	circ(10,10,7)
	pset(10,10,7)
	
	line(10,10,cos(angle)*5+10,
												sin(angle)*5+10
												,7)
	
end


function dist(x1,y1,x2,y2)
	
	xx = (x1-x2)^2
	yy = (y1-y2)^2
	
	return sqrt(xx+yy)
	
end
