-->8

node_count = 0

function add_node(parent,f
																	,g,h,pos)

	n = {parent = parent,
						f=f,
						g=g,
						h=h,
						id = node_count,
						pos=pos}

	node_count += 1

	return n

end

function pathfind(start,finish)
	
start_node = 
	add_node(nil,0,0,0,start)
	
end_node =
	add_node(nil,0,0,0,finish)	
	
open_list = {}
closed_list = {}

add(open_list,start_node)

while #open_list > 0 do
	
	current = open_list[1]
	
	for n in all(open_list) do
		if n.f < current.f then
			current = n
		end
	end
	
	if current == end_node then
		break
		print("found path!")
	end
	
	children = {}
	
	for x = -1,1,1 do
			for y = -1,1,1 do
				
				new = current
				new.pos[1] += x
				new.pos[2] += y
				
				new.parent =
					current.id
				
				if mget(new.pos[1]*8,
												new.pos[2]*8)
												!= 2 and
					new.pos[1] >=0 and 
					new.pos[2] >= 0 then
						
						add(children,new)
						
					end
			end
	end
	
	
	for c in all(children) do
		
		c.g = current.g + 1
		c.h = abs(c.pos[1] - end_node.pos[1])
							  + abs(c.pos[2] - end_node.pos[2])
		c.f = c.g + c.f
		
		add(c, open_list)
			
	end
	
	print("uh")
	
end
	
end
																		
