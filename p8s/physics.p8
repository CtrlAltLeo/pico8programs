pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
x = 0
y = 63

a = .01
v = .01

max_spd = 1.2

function _update60()
	
	t = time()
	
	v = a*t + v
	
	if abs(v) > max_spd then
		v = max_spd
		a = .01
		v = 0
	end
	
	x = x + v*t + .5*a*t^2
	
	if x > 128 then
		x = 0
	elseif x < 0 then
		x = 128
	end
	
	
end

function _draw()
	
	
	cls()
	spr(1,x,y)
	
	print(v)
	print(a)
	
end
