pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
function draw_vec(x,y)
	
	m = get_mag(x,y)
	a = get_ang(x,y)
	
	line(63,63,m*cos(a)+63,m*sin(a)+63,7)
	
	
end

function get_mag(x,y)
	
	return sqrt(x^2+y^2)
	
end

function get_ang(x,y)
	
	return atan2(x,y)
	
end

cls()
draw_vec(rnd(30)-15,rnd(30)-15)


