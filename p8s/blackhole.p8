pico-8 cartridge // http://www.pico-8.com
version 39
__lua__

mx = 63
my = 63
mr = 5

px = rnd(128)
py = rnd(128)

grav = 0

acc = 0

function _update()
	
	grav = atan2(mx - px, my - py)
	
	if btnp(➡️) then
		acc -= .1
	end
	if btnp(⬅️) then
	 acc += .1
	end
	
	px += cos(acc) + cos(grav)*time()*.25
	py += sin(acc) + sin(grav)*time()*.25
	
end


function _draw()
	cls()
	circ(mx,my,10*sin(time()),2)
	circfill(mx,my,mr*sin(time),8)
	pset(px,py,10)
	print(ang)
	
	line(px,py,2*cos(acc)+px,2*sin(acc)+py,7)
	
end
