pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- 300 miles to pigsland


function _init()

	for i = 0, 15 do
		add_slice()
		slide(8)
	end
	
	add_pig()

end

function _draw()
	cls()
	draw_map()
	draw_pigs()
	collide()
end

function _update()
	
	
		colliding = collide()

	
		if colliding == false then
			pigs[1].vy += 0.5
		else
			pigs[1].vy = 0
			
			if btnp(🅾️) then
				pigs[1].vy = -3
			end
		end
		
		
		pigs[1].y += pigs[1].vy

--if btn(❎) then
	 scroll()		
--end		
 	
end

-->8
-- pigs

pigs = {}

function add_pig()
	
	add(pigs, {s = 1,
												x = 16 - #pigs * 8,
												y = 9*8,
												vy = 0})
end

function draw_pigs()
	for p in all(pigs) do
		pset(p.x,p.y)
				pset(p.x+7,p.y+7)
		spr(p.s, p.x, p.y)
	end
end

function collide()
	p = pigs[1]
	
	pcx = p.x +4
	pcy = p.y +4
	
	for i = 1,64 do
		
		t = tiles[i]
		
		if pcx > t.x and pcx < t.x + 7
			and pcy < t.y and pcy > t.y - 7 
			and t.s == 33		
			then
				return true
			end
	end

	return false
end
-->8
-- map

x_offset = 0
y_offset = 0

tiles = {}

function add_slice()
	
	offset = #tiles % 16
	
	for y = 0, 15 do
		add(tiles, {x=127, 
														y=y*8,
								s=mget(x_offset, y+y_offset)
								}
					)
	end
	
	x_offset += 1
	
	if x_offset > 127 then
		x_offset = 0
		y_offset += 15
	end 
	
end

function drop_slice()
	for i = 1,16 do
		deli(tiles, 1)
	end
end

function slide(x)
	for t in all(tiles) do
		t.x -= x
	end
end

function draw_map()
	for t in all(tiles) do
		if t.s > 0 then
			spr(t.s, t.x, t.y)
		end
	end
end

scr = 0
function scroll()

	spd = 2

	slide(spd)
	scr += spd
	if scr == 8 then
		add_slice()
		drop_slice()
		scr = 0
	end
end


