pico-8 cartridge // http://www.pico-8.com
version 39
__lua__

p = {x=63,y=63}


function _init()
	
end

function _update()
	move_player()
end

function _draw()
	cls()
	rectfill(0,0,128,128,9)
	pset(p.x,p.y,3)
	shade()
end
-->8
--player

function move_player()
	if btn(⬅️) then
		p.x -= 1
	end
	if btn(➡️) then
		p.x += 1
	end
	if btn(⬆️) then
		p.y -= 1
	end
	if btn(⬇️) then
		p.y += 1
	end
end
-->8
--shading

function shade()
	
end
