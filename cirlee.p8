pico-8 cartridge // http://www.pico-8.com
version 39
__lua__

r = 10

function _draw()
	
	cls()
	
	
	
	for i = sin(time()), , 0.01 do
		
		x = r * cos(i) + 63
		y = r * sin(i) + 63
		
		pset(x,y,10)
		
	end
	
	r = 35 * abs(sin(time()/10))
	
end
