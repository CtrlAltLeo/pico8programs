pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
--main


function _init()
	
	
	
end

function _update()

	if time() % 1 == 0 then
		
		x = rnd(128)
		y = rnd(128)
		
		add_shape(x,y,rnd(10)+5)
	end

	for s in all(shapes) do
		do_shape(s)
		for s1 in all(shapes) do
			
			if s != s1 then
				overlap(s, s1)	
			end
				
		end
	end
end

function _draw()

	cls()

	for s in all(shapes) do
		draw_shape(s)
	end
end
-->8
--lib 

function overlap(s1, s2)		
	
	if dist(s1.x, s1.y, s2.x, s2.y) 
					<= (s1.r + s2.r)
	then
		
		s1.e = false
		s2.e = false
		
	end
	
end

function dist(x1, y1, x2, y2)
	
	x = (x2 - x1)
	y = (y2 - y1)
	
	return sqrt((x*x) + (y*y))
	
end
-->8
--shapes

shapes = {}

function add_shape(x,y,r)

	t = {
						x=x, y=y, r=r, 
						spd=rnd(.5),
						e=true,
						c = flr(rnd(15))+1
					}

	add(shapes, t)
	
end

function do_shape(s)
	if s.e then
		s.r += s.spd
	end
end

function draw_shape(s)
	circfill(s.x, s.y, s.r, s.c)
end
