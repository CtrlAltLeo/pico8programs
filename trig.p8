pico-8 cartridge // http://www.pico-8.com
version 39
__lua__


angle = 0
org = {x=63,y=63}
radius = 40

function _update()

	angle += 0.01
	
end

function _draw()
	
	cls()
	circ(org.x,org.y,radius,2)
	
	--hypeotuens
	line(org.x,org.y,
						radius*cos(angle)+org.x,
						radius*sin(angle)+org.y,11)
	
	--cos line
	line(org.x,org.y,radius*cos(angle)+org.x,org.y,8)
	
	--sine line
		line(radius*cos(angle)+org.x,org.y,radius*cos(angle)+org.x,radius*sin(angle)+org.y,10)
end
__gfx__
