pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
p = {x = 63, y = 63, 
					s = 1, f = false}
					
					
function _init()
	
end


function _update()
	
	move_p()
	
end


function _draw()
	cls()
	spr(p.s, p.x, p.y,1,1,p.f)
	
end
-->8
function move_p()

	if btn(➡️) then
		p.x += 1
		p.f = false
	end
	
	if btn(⬅️) then
		p.x -= 1
		p.f = true
	end
	
	if btn(⬅️) or btn(➡️) then
		p_ani()
	else
		p.s = 1
	end

end 


function p_ani()
	p.s += .4
	if p.s > 4 then
		p.s = 2
	end
end
