pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
--calculus 2
-- the area under the curve

t = 0

x = 0
xx = 128
step = 40

function _update()
	
	t += 0.33
	
	cls()
	
	axis()
	
	label()
	
	for i = 0,128,0.5 do
		
		pset(i, graph(i),7)
		
	end
	

	for i = 0, x, step do	
		_rect(i, step / 2, graph(i))
	end
	
	

	x = flr(t) * step

	if x > xx then
		x = 0
		t = 0
		step /= 2
	end
	
	if step < 2 then
		step = 40
	end


	
	
	
	
	
end


-->8
--graphics

--returns y
function graph(x)
	
	return -0.01*(x * x) + 128
	
end


function axis()
	
	line(0,0,0,127,8)
	line(0,127,127,127,11)
	
end

function label()
	print("y = 0.01*x^2",10,10,7)
	print("integral yo!",10,24+3*sin(time()*10),rnd(15))
end


function _rect(x, w, h)
	
	y = 126
	
	rect(x-w, y, x+w, h,10)
	
	
end
