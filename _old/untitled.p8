pico-8 cartridge // http://www.pico-8.com
version 38
__lua__

rot = 0

function _update()
	rot += 5
	
	if rot > 360 then
		rot = 0
	end
	
	px = sin(rot/360)*10
end


px,py = -10,0

word = "calculus"

function _draw()

cls()

	calc()

	for i=1,#word do
		
		print(word[i],(i*8)+26,(sin(rot/360)*8)+10)	
		
	end
	
	

end

function calc()

	for x = -20,20,.1 do
		pset(x+63,1/5*(x^2)+63,7)
	end



py = 1/5*(px^2)

pset(px+63,py+63,8)

slope = (2/5)*px

lx1 = px
ly1 = py

lx2 = px
ly2 = py

s1 = slope * 20


lx1 += 20
ly1 += s1
lx2 -= 20
ly2 -= s1

line(lx1+63,ly1+63,lx2+63,ly2+63,rnd(15))

end
