pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
rot = 180
px,py = 63,63

function _update()
	
		rotate()
	
			px += cos(rot/360)
			py += sin(rot/360)
			
	
end


function _draw()
	cls()
	print(rot)
	
	spr(choose_s(),px,py)
	
end

function rotate()
	if btnp(⬅️) then rot += 10 end
	if btnp(➡️) then rot -= 10 end
	
	if rot > 360 then
		rot = 0
	end
	
	if rot < 0 then 
		rot = 360
	end
end

function choose_s()
	
	spr_data = {19,3,2,1,17,33,34,35}
	
	c = 1
	
	for i = 0, 360, 45 do
	
		if rot >= i and rot <= i + 45
			then
				
				return spr_data[c]
			end
			
			c += 1
	end

	return spr_data[8]
end
