pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
function ang_to(x1,y1,x2,y2)
	
	vx = x2 - x1
	vy = y2 - y1
	
	return atan2(vx,vy)
	
end


x,y = 63,63

rot = 90

train = {{70,70,ang_to(70,70,x,y)}}

function add_train()
	
	
	t = train[#train]
	
	n = {t[1],t[2],t[3]}
	
	add(train, n)
	
	
end

function draw_train()
	
	for t in all(train) do
		spr(2,t[1],t[2])
	end
	
end



function upd_train()

	l = train[1]
	
	xmod = x +2* (cos(rot/360+.5))
	ymod = y + 2*(sin(rot/360+.5))
	l[3] = ang_to(l[1],l[2],xmod,ymod)
	
	l[1] += cos(l[3])
	l[2] += sin(l[3])
	
	if #train > 2 then
		--multiple train code
		for l=2,#train do
			t = train[l]
		
			xmod = train[l-1] +2* (cos(rot/360+.5))
			ymod = train[l-1] + 2*(sin(rot/360+.5))
			t[3] = ang_to(t[1],t[2],xmod,ymod)
			
			t[1] += cos(t[3])
			t[2] += sin(t[3])
		end
		
	end
	
end

function draw_player()
	spr(1,x,y)
end

function _update()
	
 x += cos(rot/360)
	y += sin(rot/360)
	
	if btn(➡️) then rot -= 5 end
	if btn(⬅️) then rot += 5 end
	
	upd_train()
	
	if btnp(❎) then
		add_train()
	end
end


function _draw()
	cls()


	draw_train()
	draw_player()
	
	line(x,y,x+2*cos(rot/360),y+2*sin(rot/360))

	
end
