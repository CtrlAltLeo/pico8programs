m = {}

print(flr(rnd(5))+1)

past_val = 1


for i = 1,16384 do
	
	val = flr(rnd(5))+1
	
	if val == past_val then
		val = flr(rnd(5))+1
	end
	
	add(m, val)
	
end

px,py = 63,63

function _update60()
	
	if btnp(⬅️) then
		sel -= 1
	end
	
	if btnp(➡️) then
		sel += 1
	end
	
end

sel = 1

function _draw()

cls()	

col = {7,6,13,1,5}
x,y = 0,0
for v in all(m) do



	pset(x,y,col[v])
	

	
	
	x += 1
	if x > 127 then
		y += 1
		x = 0
	end

end



end
