pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
e = 2.71828

function _init()

	cls()
	
	for x = 0, 64,.1 do
		
		y=exp(x)
		
		pset(x, -exp(x)+128,7)
		
		line(x, -exp(x)+128, x+1, -exp(x+1)+128,7)
		
	end

end


function exp(x)

	v = 1
	
	for i = 1,x do
		v *= e
	end

	return v

end
