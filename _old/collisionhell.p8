pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
function checkcol(x1,y1,x2,y2)
	
	for xx = x1,x1+7 do
		for yy = y1,y1+7 do
			
			if xx >= x2 and xx <= x2 + 7 
				and yy >= y2 and yy <= y2 + 7 then
					
					
					return true
				end
		end
	end
	
	return false
end

function _update()
	
	nx,ny = 0,0
	if btn(⬇️) then ny = 1 end
	if btn(➡️) then nx = 1 end
	if btn(⬆️) then ny = -1 end
	if btn(⬅️) then nx = -1 end
	
	if checkcol(px+nx,py+ny,ex,ey)
		== false then
			px += nx
			py += ny
		end
		
end

px,py = 0,0
ex,ey = 10,10

function _draw()
cls()

rectfill(px,py,px+7,py+7,2)
rectfill(ex,ey,ex+7,ey+7,3)

print(checkcol(px,py,ex,ey))
end
