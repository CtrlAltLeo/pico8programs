pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
--library


function get_col(x1,y1,
																	x2,y2)
	
	for xx = x1,x1+7 do
		for yy = y1,y1+7 do
			
			if xx >= x2 and 
				xx <= x2 + 7 and 
					yy >= y2 and 
						yy <= y2+7 then
							
							return true
						
			end
		end
	end
	
	return false
	
end

function bool2int(b)
	
	if b then
		return 1
	else	
		return 0
	end
	
end

-->8
--main


function _init()
	
	
end

function _update()
--	cls()
	move_player()
	
end

word = "you fuckin' know it"

function _draw()
	cls()
	map()
	draw_player()
	
	for i = 0,#word do
		print(word[i],i*4,sin(time()/1)*i+25,rnd(15))
	end
	
end
-->8
--player

px,py = 64,64
p_vel = 0
p_grounded = false


function move_player()
	
	vx,vy = 0,0
	

	vx = bool2int(btn(➡️)) -
						bool2int(btn(⬅️))
		
	if btn(❎) and p_grounded then
		p_vel = -4
	end
	
	if p_grounded == false then
		p_vel += .5
	end
	
	vy = p_vel
																			--added px
if check_map_col(px+vx,py) == false
		then
			px += vx
		end
																					--added vx
if check_map_col(px,py+vy) ==
	false then
		py += vy
		
		p_grounded = false
	else	
		p_grounded = true
		p_vel = 1
	end

	
	
end

function check_map_col(x,y)
	
--	mx,my = flr(x/8),flr(y/8)
	
	for xx = x,x+7 do
		for yy = y,y+7 do
			if fget(mget(
					flr(xx/8),
					flr(yy/8)
			 )) == 1 then
			 	return true
    end
		end
	end
	
	
	return false
	
end


function draw_player()
	spr(1,px,py)
end
