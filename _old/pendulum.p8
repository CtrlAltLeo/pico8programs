pico-8 cartridge // http://www.pico-8.com
version 41
__lua__


function _init()
	
end

function _update()
	
end

ot = 0.1

mod = 0.75

function _draw()
	cls()
	
	p = 2*3.1415*sqrt(1/9.8)
	
	t = ot*cos((1/p)*time()+1) + mod
	
	
	draw_p(t)
end
-->8
--draw pendulum

x = 63
y = 10
r = rnd(128)

function draw_p(theta)
	
	c = r * cos(theta) + x
	s = r * sin(theta) + y
	
	line(x,y,c,s,10)
	circfill(c,s,2,8)
	
end
