pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
cls()

for i = 0,128,.1 do
	
	x = i 
	y = -0.03125*(x-64)^2 + 127
	
	if x % 8 == 0 then
		pset(x,y,10)
	else
		pset(x,y,7)
	end
	
	if x == 0 then
		pset(0,y,12)
	end
	
	
end

rectfill(0,0,127,127,2)

--pset(0,0,11)
t = 0
function _update60()
	if t > 128 then
		t = 0
	end
	
	t += .5
	
	pset(t,-0.03125*(t-64)^2 + 127,rnd(15))
--	pset(t,-0.03125*(t-64)^2 + 127,rnd(15))
--	pset(t, (128/64^2)*(t-64)^2,rnd(15))
end
