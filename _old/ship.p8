version 39
__lua__
--main loops


function _init()

	
end

function _update()
	move_ship()
end


function _draw()
	
	cls()
	
	map()
	
	draw_ship()
	
	do_cam()
	print(ship.rot)
	--[[
	line(0,0,128,128,6)	
	r = ship.rot/360
	line(15,15,cos(r)*128,sin(r)*128,8)
	--]]
	
	print(ship.spd)
	print(ship.acc)
	
	r = ship.rot/360
	line(ship.x,ship.y,ship.x+cos(r)*5,ship.y+sin(r)*r,9)
end
-->8
--ship

ship = {x=63,
								y=63,
								rot=0,
								s=2,
								top_spd=1,
								low_spd=.05,
								spd =1,
								acc = 1}
								
function draw_ship()

	spr(ship.s, ship.x,ship.y)

	r = ship.rot
	
 if r >335 or r < 45 then
 	ship.s = 19
 elseif r > 45 and r < 135 then
 	ship.s = 2
 elseif r > 135 and r < 225 then
 	ship.s = 17
 elseif r > 225 and r < 315 then
 	ship.s = 34
 end
	
	

end

function wind_align()
	
	return (cos(ship.rot/360) * wind_vel.x) +
				(sin(ship.rot/360) * wind_vel.y)
end


function set_ship_vel(x,y)
	ship.vel.x = x
	ship.vel.y = y
end


function move_ship()
	
	if btn(➡️) then
		ship.rot -= 5
	end
	
	if btn(⬅️) then
		ship.rot += 5
	end
	
	if ship.rot >360 then
		ship.rot = 0
	end
	
	if ship.rot < 0 then
		ship.rot = 360
	end
	
	if wind_align() > 0 then
		ship.acc = .01
	else
		ship.acc = -.01
	end
	
	ship.spd = ship.acc + ship.spd
	
	if ship.spd > ship.top_spd then
		ship.spd = ship.top_spd
	end
	
	if ship.spd < 0 then
		ship.spd = ship.low_spd
	end
	
	ship.x += (cos(ship.rot/360) * ship.spd)
	ship.y += (sin(ship.rot/360) * ship.spd)
	
end
								
-->8
--wind

wind_vel= {x=1,y=1}

function draw_wind()
	
	
	
end
-->8
--camera

camx,camy = 0,0
cam_vec = {x=0,y=0}
function do_cam()
	
	cam_vec = {ship.x-63-camx,
												ship.y-63-camy}
	
	camx += cam_vec[1]/10
	camy += cam_vec[2]/10
	
	camera(camx,camy)
	
end
