pico-8 cartridge // http://www.pico-8.com
version 38
__lua__
x1,y1 = 0,0

x2,y2 = 10,10

function _update()
	
	if btn(⬅️) then x2 -= 1 end
	if btn(➡️) then x2 += 1 end
	if btn(⬆️) then y2 -= 1 end
	if btn(⬇️) then y2 += 1 end	
	
end

function _draw()
 cls()
 
 slope = (y2-y1)/(x2-x1) 
 
	for i = x1,x2,.01 do
		
		pset(i,i*slope,10)
		
	end 
 
	pset(x1,y1,3)
	
	pset(x2,y2,5)
	
	
end
__gfx__
